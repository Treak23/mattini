extends GutTest
## Pinning tests for brief M3-10: TerrainLoader gives the photo shader the surface classes
## (rock, water, path, road) and the CC0 textures it draws them with.
##
## Pinned decisions (m3-design.md §7 and §9; docs/SPEC.md §5 and §10): with a PhotoGrid and a
## SurfaceGrid the photo shader (res://shaders/terrain_photo.gdshader) declares the uniforms
## surfaces (a Texture2D sampler: the L8 class grid) and surfaces_rect (a vec4: local x0, z0,
## width_m, depth_m) and the loader sets them to the SurfaceGrid's own texture and rect(). The
## rectangle comes from WorldConfig through the reader: the shared surfaces fixture
## (tests/shared/surfaces_fixture/, a world of its own) lies at (12.0, -1.0, 40.0, 30.0)
## (tests/shared/surfaces_vectors.json: x0, z0, columns × cell_m, rows × cell_m), apart from
## the photo fixture's (412.5, -215.0, 16.0, 8.0), so the photo's rectangle passed for the
## classes' is caught. Every texture the shader declares is set (an unset sampler draws
## Godot's default texture, white, black or a flat normal, silently): the photo's, the
## classes', the CC0 files under res://textures/ (exactly the pinned files and SHA-256s below,
## each named in res://textures/LICENSE.txt, imported with mipmaps) and the water's two
## normal maps, generated by NoiseTexture2D (no file). Classes without a photo keep M2's clay
## look: the photo shader needs the photo.
##
## Read back from Terrain3DMaterial's stored parameters, as in test_terrain_loader_photo.gd:
## headless get_shader_param() returns null, and the store keeps only the uniforms the active
## shader declares.
##
## Does NOT prove: that anything renders or looks right (no GPU); that the shader decodes the
## classes exactly (texelFetch, never filtered), blends rock by slope, or fades the detail by
## near_fade_m (the brief's screenshots and review do).

const PHOTO_SHADER := "res://shaders/terrain_photo.gdshader"
const CLAY_SHADER := "res://shaders/terrain_clay.gdshader"
const TEXTURES_DIR := "res://textures"
const LICENCE_NOTE := "res://textures/LICENSE.txt"
## The CC0 textures (Poly Haven, downloaded 2026-10-14) and their SHA-256s.
const PINNED := {
	"rock_face_03_diff_2k.jpg": "644ee79df7ffbf5f6afc330b64dd3f33794bab8820915fe61ffe0c88ecfd7ece",
	"rock_face_03_nor_gl_2k.jpg":
	"a498cef4ba6191f6959b6d03fb835263c77271948264a289af24497ab7111dec",
	"rock_face_03_rough_2k.jpg": "9ca3e9e196685f702328f24d66f039b72f5330fc35cf2a2c265cfa50a7916301",
	"worn_asphalt_diff_1k.jpg": "3bf71ad290730092ad2aee85e246b2e43318bc1f32261826ba91250e815b5f72",
	"worn_asphalt_nor_gl_1k.jpg":
	"5f835d192dac296674229a763553f356f5e206bb7f6d812bca5b0f38fc5302a4",
	"rocky_trail_diff_1k.jpg": "7f20d83cd4a67f9c38abf72f39f5a3749a962e90bdc156998be027b1227a5bd6",
	"rocky_trail_nor_gl_1k.jpg": "087b8912c8cf40a528965c4282a5b3e4be011da5790273ffcdb5bd2697bde7dd",
}

var _camera: Camera3D
var _grid: TerrainGrid
var _photo: PhotoGrid
var _surfaces: SurfaceGrid
var _with_both: Terrain3D
var _surfaces_only: Terrain3D


func _repo_file(rel: String) -> String:
	return ProjectSettings.globalize_path("res://").path_join("..").path_join(rel)


func _read_json(rel: String) -> Dictionary:
	var json := JSON.new()
	assert_eq(json.parse(FileAccess.get_file_as_string(_repo_file(rel))), OK, "%s parses" % rel)
	return json.data if typeof(json.data) == TYPE_DICTIONARY else {}


## The surfaces fixture's rectangle as design computed it from LV95 (surfaces_vectors.json).
func _expected_surfaces_rect() -> Vector4:
	var v := _read_json("tests/shared/surfaces_vectors.json")
	var cell: float = v["cell_m"]
	return Vector4(v["x0"], v["z0"], v["columns"] * cell, v["rows"] * cell)


func before_all() -> void:
	var terrain_manifest := _repo_file("tests/shared/terrain_fixture/generated/manifest.json")
	_grid = TerrainGrid.from_manifest(terrain_manifest, WorldConfig.from_manifest(terrain_manifest))
	var photo_manifest := _repo_file("tests/shared/photo_fixture/generated/manifest.json")
	_photo = PhotoGrid.from_manifest(photo_manifest, WorldConfig.from_manifest(photo_manifest))
	var classes_manifest := _repo_file("tests/shared/surfaces_fixture/generated/manifest.json")
	_surfaces = SurfaceGrid.from_manifest(
		classes_manifest, WorldConfig.from_manifest(classes_manifest)
	)
	# Terrain3D looks for the viewport's camera and prints an ERROR when there is none.
	_camera = Camera3D.new()
	add_child(_camera)
	if _grid != null and _photo != null and _surfaces != null:
		_with_both = TerrainLoader.create(_grid, self, _photo, _surfaces)
	if _grid != null and _surfaces != null:
		_surfaces_only = TerrainLoader.create(_grid, self, null, _surfaces)


func after_all() -> void:
	for terrain in [_with_both, _surfaces_only]:
		if terrain != null:
			terrain.free()
	_camera.free()


func _shader_path(terrain: Terrain3D) -> String:
	var shader: Shader = terrain.material.shader_override
	return "" if shader == null else shader.resource_path


func _params(terrain: Terrain3D) -> Dictionary:
	var params: Variant = terrain.material.get("_shader_parameters")
	return params if typeof(params) == TYPE_DICTIONARY else {}


## The photo shader's sampler2D uniforms, Terrain3D's own (leading "_") left out.
func _texture_uniforms() -> PackedStringArray:
	var names := PackedStringArray()
	var shader: Shader = load(PHOTO_SHADER)
	if shader == null:
		return names
	for uniform: Dictionary in shader.get_shader_uniform_list():
		var uniform_name: String = uniform["name"]
		if uniform["hint_string"] == "Texture2D" and not uniform_name.begins_with("_"):
			names.append(uniform_name)
	return names


func test_the_fixtures_are_read() -> void:
	assert_not_null(_grid, "the terrain fixture's grid is read")
	assert_not_null(_photo, "the photo fixture's PhotoGrid is read")
	assert_not_null(_surfaces, "the surfaces fixture's SurfaceGrid is read")
	assert_not_null(_with_both, "TerrainLoader.create returns the terrain with both")
	assert_not_null(_surfaces_only, "and with the classes alone")


func test_the_photo_shader_declares_the_classes_and_their_rectangle() -> void:
	var uniforms := {}
	var shader: Shader = load(PHOTO_SHADER)
	if shader != null:
		for uniform: Dictionary in shader.get_shader_uniform_list():
			uniforms[uniform["name"]] = uniform
	assert_true(uniforms.has("surfaces"), "a surfaces uniform")
	assert_true(uniforms.has("surfaces_rect"), "a surfaces_rect uniform")
	if uniforms.has("surfaces"):
		assert_eq(uniforms["surfaces"]["type"], TYPE_OBJECT, "surfaces is a sampler")
		assert_eq(uniforms["surfaces"]["hint_string"], "Texture2D", "a sampler2D")
	if uniforms.has("surfaces_rect"):
		assert_eq(uniforms["surfaces_rect"]["type"], TYPE_VECTOR4, "surfaces_rect is a vec4")


func test_the_classes_and_their_rectangle_reach_the_shader() -> void:
	if _with_both == null:
		fail_test("no terrain was built with the photo and the classes")
		return
	assert_eq(_shader_path(_with_both), PHOTO_SHADER, "the photo look")
	var params := _params(_with_both)
	assert_same(params.get("surfaces"), _surfaces.texture, "the SurfaceGrid's own texture")
	assert_not_null(_surfaces.texture, "which exists")
	var expected := _expected_surfaces_rect()
	assert_eq(_surfaces.rect(), expected, "SurfaceGrid places the classes where design computed")
	assert_eq(params.get("surfaces_rect"), expected, "surfaces_rect is the SurfaceGrid's rectangle")
	assert_ne(params.get("surfaces_rect"), params.get("photo_rect"), "not the photo's rectangle")


func test_every_texture_the_photo_shader_samples_is_set() -> void:
	if _with_both == null:
		fail_test("no terrain was built with the photo and the classes")
		return
	var uniforms := _texture_uniforms()
	assert_true(uniforms.has("photo") and uniforms.has("surfaces"), "the samplers are listed")
	var params := _params(_with_both)
	for uniform in uniforms:
		assert_true(params.get(uniform) is Texture2D, "%s has a texture" % uniform)


func test_the_textures_are_the_pinned_cc0_files_or_generated() -> void:
	if _with_both == null:
		fail_test("no terrain was built with the photo and the classes")
		return
	var params := _params(_with_both)
	var used := {}
	var generated := 0
	for uniform in _texture_uniforms():
		var texture: Variant = params.get(uniform)
		if not (texture is Texture2D) or texture in [_photo.texture, _surfaces.texture]:
			continue
		if texture is NoiseTexture2D:
			generated += 1
			assert_true(texture.as_normal_map, "%s: a generated normal map" % uniform)
			continue
		var path: String = texture.resource_path
		assert_eq(
			path.get_base_dir(), TEXTURES_DIR, "%s: a file under %s" % [uniform, TEXTURES_DIR]
		)
		used[path.get_file()] = true
	assert_eq(used.keys().size(), PINNED.size(), "every pinned texture is used, and no other")
	assert_eq(generated, 2, "the water's two normal maps are generated (no file)")
	var note := FileAccess.get_file_as_string(LICENCE_NOTE)
	assert_string_contains(note, "CC0 1.0 Universal")
	for file: String in PINNED:
		assert_true(used.has(file), "%s is used" % file)
		var path := TEXTURES_DIR.path_join(file)
		assert_eq(FileAccess.get_sha256(path), PINNED[file], "%s: the pinned SHA-256" % file)
		assert_string_contains(note, file, false)


func test_no_texture_file_is_unpinned() -> void:
	for file in DirAccess.get_files_at(TEXTURES_DIR):
		if file.get_extension() in ["import", "uid"] or "res://textures/" + file == LICENCE_NOTE:
			continue
		assert_true(
			PINNED.has(file), "%s in %s is pinned (licence and SHA-256)" % [file, TEXTURES_DIR]
		)


func test_the_textures_have_mipmaps() -> void:
	# The detail fades with distance only through its mipmaps, and the shader's mean colour of
	# a texture is its smallest mip level; Godot imports a texture without mipmaps unless its
	# .import file asks for them (measured 2026-10-14).
	for file: String in PINNED:
		var texture: Texture2D = load(TEXTURES_DIR.path_join(file))
		assert_not_null(texture, "%s loads" % file)
		if texture != null:
			assert_true(texture.get_image().has_mipmaps(), "%s has mipmaps" % file)


func test_the_classes_without_a_photo_keep_the_clay_look() -> void:
	if _surfaces_only == null:
		fail_test("no terrain was built with the classes alone")
		return
	assert_eq(_shader_path(_surfaces_only), CLAY_SHADER, "the photo shader needs the photo")
	var params := _params(_surfaces_only)
	assert_false(params.has("surfaces") and params["surfaces"] != null, "no classes are set")
